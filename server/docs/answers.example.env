# Answers for an unattended install:
#   sudo ./install.sh install --answers answers.env
#
# Every line is optional; anything left out gets the default shown here.
# Values are read by bash, so quote anything with spaces.

TORTUGARR_LANGUAGE=en            # installer language: en | nb | sv | da | de

DATA_DIR=/srv/tortugarr          # media + downloads (one folder, so imports are instant hardlinks)

# Existing media folders to add to the library (optional). Numbered from 1.
HAS_EXTRA=n
# EXTRA_PATH_1=/mnt/disk2/Movies
# EXTRA_TYPE_1=movies          # movies | tv
# EXTRA_MANAGE_1=n             # y = Sonarr/Radarr may also add to and rename in this folder

TORRENT_CLIENT=qbittorrent     # qbittorrent | qbittorrent-ext | transmission | deluge | none
# With TORRENT_CLIENT=qbittorrent-ext (a qBittorrent you already have, not in Docker):
# its Web UI address, and its login unless Docker's network is whitelisted in it.
#EXT_QBIT_URL=http://192.168.1.15:8080
#EXT_QBIT_USER=
#EXT_QBIT_PASSWORD=
USENET_ANS=n                   # y = also install SABnzbd

VPN_ANS=n                      # y = route the torrent client through gluetun
# VPN_PROVIDER=mullvad
# VPN_TYPE=wireguard           # wireguard | openvpn
# VPN_WG_KEY=...
# VPN_WG_ADDR=10.64.1.2/32
# VPN_USER=...                 # openvpn
# VPN_PASS=...                 # openvpn
# VPN_COUNTRIES=Netherlands

HWACCEL_ANS=y                  # use /dev/dri for Jellyfin transcoding when a GPU is present

# LAN_IP=192.168.1.20          # default: detected
# TZ_NAME=America/New_York      # default: the system time zone
METADATA_LANG=en               # en | nb | sv | da | de | fr | es
SUB_LANGS=en                   # subtitle languages, two-letter codes; English by default, add more if you want: en,de ...
QUALITY_PROFILE=HD-1080p       # HD-1080p | "HD - 720p/1080p" | Ultra-HD | Any

P_JELLYFIN=8096
P_SEERR=5055
P_SONARR=8989
P_RADARR=7878
P_PROWLARR=9696
P_BAZARR=6767
# P_TORRENT_WEB=8080           # default depends on the client: 8080 / 9091 / 8112
P_TORRENT_PEER=6881
P_SABNZBD=8085

# Required: the login for every service, chosen by you. Username: 3-32 letters, digits,
# . _ or -. Password: at least 8 characters, no spaces or quote characters.
ADMIN_USER=
ADMIN_PASSWORD=

# FOREIGN_OK=y                 # install even if another media server/*arr is found (it is never touched)
GO=y                           # start without asking

# Only used inside WSL2 (unsupported): the optional Windows helper.
# WINDOWS_HELPER=yes                # yes = set up port forwarding, firewall and keep-alive; no = skip
# WINDOWS_PUBLIC_NETWORK=private    # on a Public network: private | localsubnet | leave

