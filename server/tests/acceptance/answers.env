# Answers for the acceptance test install (see tests/acceptance/README.md).
TORTUGARR_LANGUAGE=en
DATA_DIR=/srv/tortugarr

# The library prepare-media.sh built, which Sonarr/Radarr may also manage.
HAS_EXTRA=y
EXTRA_PATH_1=/srv/existing/Movies
EXTRA_TYPE_1=movies
EXTRA_MANAGE_1=y
EXTRA_PATH_2=/srv/existing/TV
EXTRA_TYPE_2=tv
EXTRA_MANAGE_2=y

TORRENT_CLIENT=qbittorrent
USENET_ANS=n
VPN_ANS=n
HWACCEL_ANS=n
METADATA_LANG=en
SUB_LANGS=en
QUALITY_PROFILE=HD-1080p
ADMIN_USER=tortugarr-test
ADMIN_PASSWORD='change-me-test-only-1'   # a throwaway test VM only
GO=y
