# Pinned container images for this Tortugarr release.
#
# Every image is pinned by digest, so an install today and an install in a year
# pull exactly the same bytes. The tag in front of the digest is only a label;
# the digest wins. `install.sh update` moves these forward deliberately.
#
# Every image is a released upstream version (never a moving 'latest' build), and the
# whole set is tested together end to end on a clean machine before a release.

# The Tortugarr version - the same number as the app (io.github.tortugarr). The Jellyfin
# plugin has its own version.
TORTUGARR_VERSION=4.20.0

IMAGE_JELLYFIN=jellyfin/jellyfin:12.0.0@sha256:baba630419915985442f315f08b0cf46d9f4c8a0cc4bd38e94a6d35751dd5ef5
IMAGE_SONARR=lscr.io/linuxserver/sonarr:4.0.19.2979-ls323@sha256:4d9df314875e1249ab7d6170c2b9b3dc1d8e6383f168ceb10dc9a5ad9b324739
IMAGE_RADARR=lscr.io/linuxserver/radarr:6.4.4.10685-ls319@sha256:7dfd049e79c00b16fbc29c3f5d96a9e7b9e73a23930b4c5b3c4541d60b366814
IMAGE_PROWLARR=lscr.io/linuxserver/prowlarr:2.6.5.5623-ls163@sha256:f9151e5bc1025c6d0a630d503210cdcb6bb55a7cc098562609d96a408d838902
IMAGE_BAZARR=lscr.io/linuxserver/bazarr:v1.6.2-ls366@sha256:8b30e81c4aec2991f469e78fae8afaa89ecc9b21a80e3897f50427216b55470c
IMAGE_SEERR=ghcr.io/seerr-team/seerr:v3.4.1@sha256:f4768de5f616248d723e05891f3345a1402123775d03bf0890dbfedc0831bda1
IMAGE_FLARESOLVERR=ghcr.io/flaresolverr/flaresolverr:v3.5.0@sha256:139dfee1c6f89249c8d665d1333a42e8ec74ec0a86bc6bb1c8461e10d3a66a47

# Download clients - exactly one torrent client is active (or none), plus optional usenet.
IMAGE_QBITTORRENT=lscr.io/linuxserver/qbittorrent:5.2.3_v2.0.14-ls477@sha256:457e4eec2ee3f5e4ef59f237ad51f6143deba9f7445ab48bb5204a98888ef9aa
IMAGE_TRANSMISSION=lscr.io/linuxserver/transmission:4.1.3-r0-ls362@sha256:1a12fef3c89eca48b7be9e7d36b17b4eb4e1bcf5e1ee7fbf372e3a38b562939d
IMAGE_DELUGE=lscr.io/linuxserver/deluge:2.2.0-ls382@sha256:9505c64720afa9e5f0ac1576e660dd6d1e9d4a6733b791f4821e8f496f19f41f
IMAGE_SABNZBD=lscr.io/linuxserver/sabnzbd:5.1.3-ls274@sha256:4f7ee6c53834bc336365bd0a7c35f4fc870156a72d33a334753010258aa077a4

# Optional VPN for the download client.
IMAGE_GLUETUN=qmcgaw/gluetun:v3.41.1@sha256:1a5bf4b4820a879cdf8d93d7ef0d2d963af56670c9ebff8981860b6804ebc8ab

# Runs the configuration engine (bootstrap/), so the host needs nothing but Docker.
IMAGE_TOOLS=python:3.12-alpine@sha256:4c47124a8391cb7a9f571164147d154777cf012a4ece5f86097130d7a4478111

# Moonfin server plugin ("Moonbase") for Jellyfin, installed from its official repository.
MOONFIN_PLUGIN_REPO=https://raw.githubusercontent.com/Moonfin-Client/Plugin/master/manifest.json
MOONFIN_PLUGIN_GUID=8c5d0e91-4f2a-4b6d-9e3f-1a7c8d9e0f2b
MOONFIN_PLUGIN_VERSION=2.0.2.0
